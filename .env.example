# ─── Broker (Alpaca) ─────────────────────────────────────────────────────────
# PAPER keys. Get them free at https://alpaca.markets — a paper account needs no
# funding. The engine runs entirely on these.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex          # iex (free) | sip (paid)

# ─── LLM (only needed for decide.py / macro_context.py) ──────────────────────
# The signal engine (research.py) runs WITHOUT this. Only the decision layer
# and the macro brief call a model.
ANTHROPIC_API_KEY=

# ─── Optional: mirror artifacts to YOUR OWN GitHub repo ─────────────────────
# Both are required; there is deliberately no default repo. A built-in slug
# would aim an unconfigured clone at somebody else's repository — and since a
# file from this repo is fed to the model as a directive, that is an injection
# path, not just a data leak. See artifact_repo.py.
GITHUB_TOKEN=
GITHUB_REPO=                  # e.g. you/your-trading-agent

# ─── Optional data ───────────────────────────────────────────────────────────
FRED_API_KEY=                 # macro regime (free)
PREDICTION_MARKETS=false      # Polymarket macro probabilities (no key needed)

# ─── Feature flags (all default OFF) ─────────────────────────────────────────
MEMORY_V2=false               # outcome scorecard + lessons in TRADING_MEMORY.md
DEBATE_BUYS=false             # bull/bear veto on proposed buys
DEBATE_SHADOW=false           # ...record verdicts without acting on them
ANALYST_VIEWS=false           # per-candidate stance decomposition
INSIDER_FLOW=false            # SEC Form 4 cluster buys
FUNDAMENTALS_LENS=false

# ─── REAL MONEY ──────────────────────────────────────────────────────────────
# Four independent gates, ALL required. Leave these alone unless you have read
# accounts.is_live() and mean it. Default is paper, always.
# I_UNDERSTAND_THIS_TRADES_REAL_MONEY=yes
# LIVE_TRADING=true
# LIVE_ACCOUNTS=core
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_SECRET_KEY=

# ─── Liquidity & corporate actions (ON by default — see trade.py) ─────────────
# ADV_MAX_PCT: reject a buy larger than this share of 20-day average dollar
# volume. Defaults to 0.01 (1%). It is the ONLY check that looks at today's
# volume at order time, so a name whose liquidity collapsed since the last
# universe rebuild is caught here. Set to 0 to disable (not recommended).
ADV_MAX_PCT=0.01
SPLIT_GUARD_PCT=0.35          # block buys when price is this far from SMA20
CORP_ACTIONS=true             # fetch split history so small splits are caught too
CORP_ACTION_WORKERS=8         # parallel lookups; raise only if your source allows
